<UserControl x:Class="WpfLabApp.Views.BindingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1050">

    <UserControl.Resources>
        <SolidColorBrush x:Key="WarningBrushLocal" Color="#F59E0B"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="DemoRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <!-- Заголовок и панель последнего обновления -->
            <Border Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Привязка данных (Data Binding) и режимы обновления"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Интерактивная демонстрация всех значений Binding.Mode и UpdateSourceTrigger в WPF"
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0F172A" BorderBrush="{StaticResource InfoBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastUpdatedInfo}"
                                   FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New"
                                   Foreground="{StaticResource InfoBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- РАЗДЕЛ 1: Типы привязки (Binding.Mode) -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="1. Типы привязки (Binding.Mode)"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Управляйте свойством ModeSourceText из ViewModel или через поля ввода, чтобы увидеть разницу в направлении потока данных."
                               FontSize="12.5" Margin="0,4,0,14" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- Панель управления источником ViewModel -->
                    <Border Background="#162032" BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Источник ViewModel (ModeSourceText):"
                                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ModeSourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Content="Изменить из ViewModel"
                                    Command="{Binding ChangeModeSourceCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="3" Content="Сбросить"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetModeSourceCommand}"/>
                        </Grid>
                    </Border>

                    <!-- OneWay -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#1E3A8A">
                                <TextBlock Text="Mode=OneWay" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding ModeSourceText, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                       Text="Только Источник → Цель. Ввод текста в это поле НЕ меняет ViewModel, но кнопка «Изменить из ViewModel» обновит его."/>
                        </Grid>
                    </Border>

                    <!-- TwoWay -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#064E3B">
                                <TextBlock Text="Mode=TwoWay" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding ModeSourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                       Text="Двусторонняя синхронизация (Источник ↔ Цель). Изменения в поле сразу обновляют ViewModel и все связанные элементы."/>
                        </Grid>
                    </Border>

                    <!-- OneTime -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#3B0764">
                                <TextBlock Text="Mode=OneTime" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0" IsReadOnly="True"
                                     Text="{Binding ModeSourceText, Mode=OneTime}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                       Text="Однократная загрузка при инициализации. После создания вкладки значение больше никогда не обновляется от ViewModel."/>
                        </Grid>
                    </Border>

                    <!-- OneWayToSource -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#451A03">
                                <TextBlock Text="Mode=OneWayToSource" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource WarningBrushLocal}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding OneWayToSourceTargetText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                           Text="Только Цель → Источник. Поле стартует пустым, но ввод передаёт данные в ViewModel:"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Значение в ViewModel: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding OneWayToSourceTargetText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrushLocal}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Default -->
                    <Border Style="{StaticResource DemoRowCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#083344">
                                <TextBlock Text="Mode=Default" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource InfoBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBox Text="{Binding ModeSourceText, Mode=Default}" Margin="0,0,0,6"/>
                                <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding ModeSourceText, Mode=Default}"
                                               Foreground="{StaticResource InfoBrush}" FontSize="12.5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                       Text="Режим зависит от свойства-цели: для TextBox.Text по умолчанию используется TwoWay, а для TextBlock.Text — OneWay."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- РАЗДЕЛ 2: Режимы обновления источника (UpdateSourceTrigger) -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="2. Режимы обновления источника (UpdateSourceTrigger)"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Определяют момент отправки нового значения из UI-элемента обратно в свойство ViewModel."
                               FontSize="12.5" Margin="0,4,0,14" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- PropertyChanged -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#064E3B">
                                <TextBlock Text="PropertyChanged" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding PropertyChangedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="В ViewModel: " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PropertyChangedText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Обновляет источник мгновенно при каждом нажатии клавиши."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- LostFocus -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#1E3A8A">
                                <TextBlock Text="LostFocus" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding LostFocusText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="В ViewModel: " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LostFocusText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Обновляет источник только после потери фокуса (нажмите Tab или кликните в другое место)."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Explicit -->
                    <Border Style="{StaticResource DemoRowCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#451A03">
                                <TextBlock Text="Explicit" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource WarningBrushLocal}"/>
                            </Border>
                            <TextBox x:Name="ExplicitTextBox" Grid.Column="1" Margin="0,0,10,0"
                                     Text="{Binding ExplicitText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                            <Button Grid.Column="2" Content="Обновить (UpdateSource)"
                                    Click="UpdateExplicitBinding_Click"
                                    Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="В ViewModel: " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ExplicitText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrushLocal}"/>
                                </StackPanel>
                                <TextBlock Text="Источник обновляется только при явном вызове BindingExpression.UpdateSource()."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Default -->
                    <Border Style="{StaticResource DemoRowCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ModeBadgeStyle}" Background="#083344">
                                <TextBlock Text="Default" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource InfoBrush}"/>
                            </Border>
                            <TextBox Grid.Column="1" Margin="0,0,16,0"
                                     Text="{Binding DefaultTriggerText, Mode=TwoWay, UpdateSourceTrigger=Default}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="В ViewModel: " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DefaultTriggerText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource InfoBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Для TextBox.Text значением по умолчанию является LostFocus (для большинства других свойств — PropertyChanged)."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
